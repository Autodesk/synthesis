{
  "name": "synthesis-fission",
  "private": false,
  "version": "7.1.0",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "author": "Autodesk",
  "description": "Synthesis",
  "scripts": {
    "init": "(bun run assetpack && bun run playwright:install) || (npm run assetpack && npm run playwright:install)",
    "host": "vite --open --host",
    "dev": "vite --open",
    "test": "vitest",
    "build": "tsc && vite build",
    "build:prod": "tsc && vite build --base=/fission/ --outDir dist/prod",
    "build:dev": "tsc && vite build --base=/fission-closed/ --outDir dist/dev",
    "preview": "vite preview --base=/fission/",
    "lint": "bunx biome lint",
    "lint:fix": "bunx biome lint --write",
    "fmt": "bunx biome format src",
    "fmt:fix": "bunx biome format src --write",
    "style": "bunx biome check src",
    "style:fix": "bunx biome check src --write",
    "assetpack": "git lfs pull && (rm -rf public/Downloadables;tar -xf public/assetpack.zip -C public/)",
    "assetpack:update": "bun update_manifest.ts && cd public && zip -FS -r assetpack.zip Downloadables -x '**/.*' -x '**/__MACOSX'",
    "assetpack:merge": "git checkout --theirs public/assetpack.zip && rm -rf public/Downloadables && tar -xf public/assetpack.zip -C public/ && git checkout --ours public/assetpack.zip && tar -xf public/assetpack.zip -C public/ && bun run assetpack:update",
    "playwright:install": "bun x playwright install",
    "electron:make": "electron-forge make",
    "electron:start": "electron-forge start",
    "electron:package": "electron-forge package",
    "electron:publish": "electron-forge publish"
  },
  "dependencies": {
    "@azaleacolburn/jolt-physics": "^0.31.2",
    "@biomejs/biome": "^2.5.0",
    "@haensl/google-analytics": "^1.2.2",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@mui/system": "^5.18.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@vitest/browser": "^4.1.9",
    "@vitest/browser-playwright": "^4.1.9",
    "@xyflow/react": "^12.11.0",
    "async-mutex": "^0.5.0",
    "electron-squirrel-startup": "^1.0.1",
    "framer-motion": "^12.40.0",
    "fuse.js": "^7.4.2",
    "lygia": "^1.4.1",
    "msw": "^2.14.6",
    "notistack": "^3.0.2",
    "peerjs": "^1.5.5",
    "playwright": "^1.61.0",
    "postprocessing": "^6.39.1",
    "react": "^19.2.7",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.7",
    "react-draggable": "^4.7.0",
    "react-icons": "^5.6.0",
    "three": "^0.184.0",
    "uuid": "^14.0.0",
    "vitest-browser-react": "^2.2.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^2.1.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "cssnano": "^8.0.2",
    "electron": "^42.4.1",
    "pako": "^2.1.0",
    "peer": "^1.0.2",
    "postcss": "^8.5.15",
    "protobufjs": "^8.6.4",
    "protobufjs-cli": "^2.5.5",
    "rollup": "^4.62.2",
    "tailwindcss": "^4.3.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vite-plugin-glsl": "^1.6.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "ws": ">=8.20.1",
    "qs": ">=6.15.2",
    "lodash": ">=4.18.1",
    "underscore": ">=1.13.8",
    "tar": ">=7.5.7",
    "@xmldom/xmldom": ">=0.9.10",
    "@tootallnate/once": ">=2.0.1",
    "esbuild": ">=0.28.1",
    "yaml": ">=1.10.3",
    "path-to-regexp": ">=0.1.13",
    "picomatch": ">=2.3.2",
    "minimatch": ">=3.1.3",
    "markdown-it": ">=14.1.1",
    "tmp": ">0.2.3",
    "ip-address": ">10.1.0",
    "brace-expansion": ">=1.1.13"
  },
  "license": "Apache-2.0",
  "repository": {
    "url": "https://github.com/Autodesk/synthesis.git"
